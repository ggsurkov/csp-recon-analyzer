/target
**/*.rs.bk
Cargo.lock.orig

# Generated wasm-bindgen output. Rebuilt by `npm run wasm`; never edited by hand.
/pkg
/crates/*/pkg
/apps/web/src/lib/wasm/

# Demo asset copied out of fixtures/ by `npm run demo`. The .bin suffix keeps static hosts
# from serving it with Content-Encoding: gzip — see apps/web/scripts/copy-fixture.mjs.
/apps/web/public/demo/

# Python bytecode from scripts/ (generate_1gb_recon.py imports the schema from
# generate_mock_recon.py, which materialises a __pycache__ next to them).
__pycache__/
*.pyc

# Node / Vite UI
node_modules/
.svelte-kit/
build/
dist/
.vite/

# Secrets. Nothing in this repository should ever need one, which is exactly why an
# .env showing up unnoticed would be the dangerous case.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Real reconciliation exports must never be committed. Only fixtures/ is tracked,
# and everything in it is synthetic.
*.csv
*.csv.gz
!fixtures/mock_recon_2026.csv.gz
!fixtures/*.sample.csv

.DS_Store
Thumbs.db

#agents
CLAUDE.md
.claude/*

# IDE / Editors
.vscode/
.idea/
*.swp
*.workspace