{
  "name": "reconledger-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-only analyser for Microsoft Partner Center reconciliation exports.",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/recon-wasm --target web --out-dir ../../apps/web/src/lib/wasm --out-name recon_wasm --release",
    "prebuild": "npm run wasm",
    "predev": "npm run wasm",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
